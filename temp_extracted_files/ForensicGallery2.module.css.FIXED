/* ══════════════════════════════════════════════════════════════════════════════
   FORENSIC GALLERY 2 - CSS GRID LAYOUT (FIXED)
   ══════════════════════════════════════════════════════════════════════════════ */

/* ── Variables y configuración global ──────────────────────────────────────── */
.gallery {
  --panel-width: 270px;
  --panel-bg: var(--ifm-background-surface-color);
  --border: var(--ifm-color-emphasis-200);
  --radius: 10px;
  --nav-height: 60px; /* Altura aproximada del navbar */
  
  /* ✅ GRID MAESTRO CON FILAS BIEN DEFINIDAS */
  display: grid;
  grid-template-columns: var(--panel-width) 1fr;
  grid-template-rows: 1fr auto; /* 1fr = espacio flexible, auto = contenido */
  gap: 0;
  
  /* ✅ Altura mínima que ocupa toda la pantalla menos navbar */
  min-height: calc(100vh - var(--nav-height));
  position: relative;
  
  /* ✅ Evitar que el grid se contraiga */
  width: 100%;
  max-width: 100%;
}

/* ══════════════════════════════════════════════════════════════════════════════
   PANEL IZQUIERDO (Sticky sidebar)
   ══════════════════════════════════════════════════════════════════════════════ */
.leftPanel {
  width: var(--panel-width);
  min-width: var(--panel-width);
  max-width: var(--panel-width);
  background: var(--panel-bg);
  border-right: 1px solid var(--border);
  
  /* ✅ Flexbox para contenido interno */
  display: flex;
  flex-direction: column;
  
  /* ✅ Posicionamiento sticky */
  position: sticky;
  top: var(--nav-height);
  
  /* ✅ Altura máxima para que no crezca infinitamente */
  max-height: calc(100vh - var(--nav-height));
  overflow-y: auto;
  overflow-x: hidden;
  
  /* ✅ Asignación explícita en el grid */
  grid-column: 1;
  grid-row: 1 / 3; /* ✅ Ocupa ambas filas (importante para layouts altos) */
  
  /* Scroll customizado */
  scroll-behavior: smooth;
}

/* ✅ Scrollbar styling (opcional) */
.leftPanel::-webkit-scrollbar {
  width: 6px;
}
.leftPanel::-webkit-scrollbar-track {
  background: transparent;
}
.leftPanel::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 3px;
}

/* ══════════════════════════════════════════════════════════════════════════════
   ÁREA DE GRÁFICA (Chart area con header)
   ══════════════════════════════════════════════════════════════════════════════ */
.chartArea {
  grid-column: 2;
  grid-row: 1; /* ✅ Fila superior únicamente */
  
  /* ✅ Min-width 0 fuerza el context de BFC (Block Formatting Context) */
  min-width: 0;
  
  /* ✅ Padding y layout */
  padding: 1.5rem 2rem 1rem 2rem;
  display: flex;
  flex-direction: column;
  
  /* ✅ Garantiza que ocupe todo el espacio disponible */
  height: 100%;
  
  /* ✅ Evitar overflow accidental */
  overflow: hidden;
  
  /* ✅ Background para debugging visual */
  background: var(--ifm-background-color);
  position: relative;
}

/* ── Chart Header ──────────────────────────────────────────────────────────── */
.chartHeader {
  flex: 0 0 auto; /* ✅ No crece, no se encoge, tamaño del contenido */
  margin-bottom: 1rem;
}

.chartHeaderTop {
  margin-bottom: 0.5rem;
}

.chartTitle {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
  line-height: 1.3;
}

.chartSubtitle {
  font-size: 0.95rem;
  color: var(--ifm-color-emphasis-700);
  margin: 0.5rem 0 0 0;
}

.chartHeaderMeta {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  margin-top: 0.75rem;
  flex-wrap: wrap;
}

.sourceBadge {
  padding: 0.25rem 0.75rem;
  border-radius: 4px;
  font-size: 0.85rem;
  font-weight: 600;
  border: 1px solid transparent;
}

.sourceBadge.esios {
  background: rgba(255, 170, 0, 0.1);
  color: #ff8800;
  border-color: #ffaa00;
}

.sourceBadge.entsoe {
  background: rgba(51, 221, 255, 0.1);
  color: #1e90ff;
  border-color: #33ddff;
}

.techCode {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.8rem;
  padding: 0.25rem 0.5rem;
  background: var(--ifm-color-emphasis-100);
  border-radius: 3px;
  color: var(--ifm-color-emphasis-800);
}

/* ══════════════════════════════════════════════════════════════════════════════
   CONTENEDOR DE GRÁFICA (ResposiveContainer)
   ══════════════════════════════════════════════════════════════════════════════ */
.chartContainer {
  /* ✅ Absorbe TODO el espacio vertical disponible */
  flex: 1;
  
  /* ✅ Mínimo para evitar colapso */
  min-height: 400px;
  
  /* ✅ Máximo para no ser demasiado grande */
  max-height: calc(100vh - 400px);
  
  /* ✅ Posición relativa para que ResposiveContainer calcule 100% */
  position: relative;
  
  /* ✅ Evitar que sobresalga del contenedor */
  overflow: hidden;
  
  /* ✅ Permite que Recharts use el 100% del espacio */
  width: 100%;
  height: 100%;
  
  /* Margen inferior para separación */
  margin-bottom: 0;
}

/* ══════════════════════════════════════════════════════════════════════════════
   ÁREA INFERIOR (Descripción, Relevancia, Navegación)
   ══════════════════════════════════════════════════════════════════════════════ */
.bottomArea {
  grid-column: 1 / -1; /* ✅ Ocupa ambas columnas (ancho completo) */
  grid-row: 2;         /* ✅ Fila 2, debajo de todo */
  
  /* ✅ Contenido sin comprimir la fila superior */
  padding: 1rem 2rem 3rem 2rem;
  
  /* ✅ Ancho máximo para no ser demasiado amplio */
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  
  /* ✅ Scroll si el contenido es muy largo */
  overflow-y: auto;
  max-height: 50vh; /* ✅ Limita altura para no ocupar toda la pantalla */
  
  /* Background para separación visual */
  background: var(--ifm-background-surface-color);
  border-top: 1px solid var(--border);
}

/* ── Secciones internas ────────────────────────────────────────────────────── */
.descSection,
.relSection {
  margin-bottom: 2rem;
}

.descSection:last-of-type {
  margin-bottom: 1rem;
}

.descTitle,
.relTitle {
  font-weight: 600;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.descText,
.relText {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--ifm-color-emphasis-800);
}

.descText p,
.relText p {
  margin: 0.5rem 0;
}

.descText p:first-child,
.relText p:first-child {
  margin-top: 0;
}

.descText p:last-child,
.relText p:last-child {
  margin-bottom: 0;
}

.relSection {
  padding-left: 1rem;
  border-left: 3px solid currentColor; /* ✅ Usa el color de la categoría */
}

/* ── Botones de navegación ─────────────────────────────────────────────────── */
.navButtons {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 2rem;
  flex-wrap: wrap;
}

.navBtn {
  flex: 1;
  min-width: 150px;
  padding: 0.75rem 1rem;
  border: 1px solid var(--border);
  background: var(--ifm-background-color);
  color: var(--ifm-color-emphasis-900);
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 0.95rem;
  font-weight: 500;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.25rem;
}

.navBtn:hover {
  border-color: var(--ifm-color-primary);
  background: var(--ifm-color-emphasis-50);
  transform: translateY(-2px);
}

.navBtn.next {
  align-items: flex-end;
}

.navBtnSub {
  font-size: 0.85rem;
  color: var(--ifm-color-emphasis-700);
  font-weight: normal;
}

.nextCatBtn {
  border-color: currentColor;
  background: rgba(0, 0, 0, 0.02);
}

/* ══════════════════════════════════════════════════════════════════════════════
   LOADING STATE
   ══════════════════════════════════════════════════════════════════════════════ */
.chartLoading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  flex-direction: column;
  gap: 1rem;
  color: var(--ifm-color-emphasis-600);
}

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--ifm-color-emphasis-200);
  border-top: 3px solid currentColor;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ══════════════════════════════════════════════════════════════════════════════
   MOBILE TOGGLE BUTTONS
   ══════════════════════════════════════════════════════════════════════════════ */
.mobileDescToggle,
.mobileRelToggle {
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--ifm-color-emphasis-100);
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  font-weight: 600;
  text-align: left;
  display: none; /* ✅ Oculto por defecto (mostrar en móvil) */
}

/* ══════════════════════════════════════════════════════════════════════════════
   RESPONSIVE: TABLETAS (< 1024px)
   ══════════════════════════════════════════════════════════════════════════════ */
@media (max-width: 1023px) {
  .gallery {
    --panel-width: 220px;
  }
  
  .chartArea {
    padding: 1rem 1.5rem;
  }
  
  .bottomArea {
    padding: 1rem 1.5rem 2rem;
    max-height: 40vh;
  }
}

/* ══════════════════════════════════════════════════════════════════════════════
   RESPONSIVE: MÓVIL (< 768px)
   ══════════════════════════════════════════════════════════════════════════════ */
@media (max-width: 767px) {
  .gallery {
    /* ✅ Cambia a Flexbox para móvil */
    display: flex;
    flex-direction: column;
    min-height: auto; /* Permite que crezca con contenido */
    gap: 0;
  }
  
  .leftPanel {
    /* ✅ Mostrar como horizontal scrollable o expandible */
    display: none; /* Ocultar por defecto, mostrar con menú hamburguesa */
    position: static;
    width: 100%;
    max-width: 100%;
    max-height: none;
    border-right: none;
    border-bottom: 1px solid var(--border);
    top: auto;
    sticky: none;
  }
  
  .leftPanel.mobileOpen {
    display: flex; /* Mostrar cuando está abierto */
  }
  
  .mobileMenuBar {
    display: flex; /* Botón hamburguesa visible */
    padding: 0.75rem 1rem;
    gap: 0.5rem;
    background: var(--panel-bg);
    border-bottom: 1px solid var(--border);
    justify-content: space-between;
    align-items: center;
  }
  
  .chartArea {
    grid-column: auto;
    grid-row: auto;
    width: 100%;
    min-width: 0;
    height: auto;
    padding: 1rem;
    overflow: visible;
  }
  
  .chartContainer {
    min-height: 350px;
    max-height: 500px;
  }
  
  .chartTitle {
    font-size: 1.25rem;
  }
  
  .bottomArea {
    grid-column: auto;
    grid-row: auto;
    width: 100%;
    max-width: 100%;
    max-height: none;
    overflow-y: visible;
    padding: 1rem;
    border-top: 1px solid var(--border);
  }
  
  /* ✅ Mostrar toggles en móvil */
  .mobileDescToggle,
  .mobileRelToggle {
    display: block;
  }
  
  .descSection,
  .relSection {
    margin-bottom: 1rem;
  }
  
  .navButtons {
    flex-direction: column;
  }
  
  .navBtn {
    flex: 1;
    min-width: auto;
    width: 100%;
  }
  
  .descTitle,
  .relTitle {
    font-size: 1rem;
  }
  
  .descText,
  .relText {
    font-size: 0.9rem;
  }
}

/* ══════════════════════════════════════════════════════════════════════════════
   PEQUEÑOS DISPOSITIVOS (< 480px)
   ══════════════════════════════════════════════════════════════════════════════ */
@media (max-width: 479px) {
  .chartArea {
    padding: 0.75rem;
  }
  
  .chartContainer {
    min-height: 300px;
  }
  
  .chartTitle {
    font-size: 1.1rem;
  }
  
  .bottomArea {
    padding: 0.75rem;
  }
  
  .chartHeaderMeta {
    gap: 0.5rem;
  }
  
  .sourceBadge {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
  }
  
  .techCode {
    font-size: 0.75rem;
  }
}
